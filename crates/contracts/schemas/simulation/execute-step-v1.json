{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edgeagent:schema:simulation:execute-step:v1",
  "title": "ExecuteDryRunStep",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "account", "plan", "sequence", "expected_revision"],
  "properties": {
    "mode": {"const": "dry_run"},
    "account": {"type": "string", "pattern": "^[0-9a-f]{32}$", "not": {"pattern": "^0+$"}},
    "plan": {"type": "string", "pattern": "^[0-9a-f]{64}$", "not": {"pattern": "^0+$"}},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "expected_revision": {"type": "integer", "minimum": 0, "maximum": 9223372036854775806}
  }
}
