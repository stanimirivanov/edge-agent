{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edgeagent:schema:simulation:submit-order:v1",
  "title": "SubmitDryRunOrder",
  "type": "object",
  "required": ["mode", "account", "order", "quote", "expected_revision", "input_revision"],
  "properties": {
    "mode": {"const": "dry_run"},
    "account": {"type": "string", "pattern": "^(?!0{32}$)[0-9a-f]{32}$", "minLength": 32, "maxLength": 32},
    "order": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$", "minLength": 64, "maxLength": 64},
    "quote": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$", "minLength": 64, "maxLength": 64},
    "expected_revision": {"type": "integer", "minimum": 0, "maximum": 9223372036854775806},
    "input_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
  }
}
