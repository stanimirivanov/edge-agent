{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edgeagent:schema:simulation:settle-account:v1",
  "type": "object", "additionalProperties": false,
  "required": ["mode", "account", "plan", "sequence", "expected_revision"],
  "properties": {
    "mode": {"const": "dry_run"},
    "account": {"type":"string","pattern":"^(?!0{32}$)[0-9a-f]{32}$"},
    "plan": {"type":"string","pattern":"^(?!0{64}$)[0-9a-f]{64}$"},
    "sequence": {"type":"integer","minimum":1,"maximum":9223372036854775807},
    "expected_revision": {"type":"integer","minimum":0,"maximum":9223372036854775806}
  }
}
