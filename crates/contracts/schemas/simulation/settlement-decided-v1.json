{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:edgeagent:schema:simulation:settlement-decided:v1",
  "type":"object","additionalProperties":false,
  "required":["request","account_revision","instrument","status","run","policy","evidence","allocations","expired_orders"],
  "properties":{
    "request":{"$ref":"urn:edgeagent:schema:simulation:settle-account:v1"},
    "account_revision":{"type":"integer","minimum":1,"maximum":9223372036854775807},
    "instrument":{"$ref":"#/$defs/id32"},"run":{"$ref":"#/$defs/id64"},"policy":{"$ref":"#/$defs/id64"},
    "evidence":{"anyOf":[{"$ref":"#/$defs/id64"},{"type":"null"}]},
    "status":{"enum":["settled","already_settled","deferred_not_due","deferred_missing","deferred_not_known"]},
    "allocations":{"type":"array","maxItems":32,"items":{"type":"object","additionalProperties":false,"required":["strategy","contracts","gross_cents","fee_cents","postings"],"properties":{
      "strategy":{"$ref":"#/$defs/id32"},"contracts":{"type":"integer","minimum":1,"maximum":9223372036854775807},
      "gross_cents":{"$ref":"#/$defs/unsigned"},"fee_cents":{"$ref":"#/$defs/unsigned"},
      "postings":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"integer","minimum":-9223372036854775808,"maximum":9223372036854775807}}
    }}},
    "expired_orders":{"type":"array","maxItems":32,"items":{"type":"array","minItems":2,"maxItems":2,"prefixItems":[{"$ref":"#/$defs/id64"},{"type":"integer","minimum":1,"maximum":9223372036854775807}],"items":false}}
  },
  "allOf":[
    {"if":{"properties":{"status":{"enum":["settled","already_settled"]}}},"then":{"properties":{"evidence":{"$ref":"#/$defs/id64"}}},"else":{"properties":{"evidence":{"type":"null"}}}},
    {"if":{"properties":{"status":{"not":{"const":"settled"}}}},"then":{"properties":{"allocations":{"maxItems":0},"expired_orders":{"maxItems":0}}}}
  ],
  "$defs":{
    "id32":{"type":"string","pattern":"^(?!0{32}$)[0-9a-f]{32}$"},
    "id64":{"type":"string","pattern":"^(?!0{64}$)[0-9a-f]{64}$"},
    "unsigned":{"type":"integer","minimum":0,"maximum":9223372036854775807}
  }
}
