                    "coefficient": {
                      "description": "0 or 1..28 base-ten digits, with no leading zero/sign/exponent.",
                      "maxLength": 28,
                      "minLength": 1,
                      "pattern": "^(0|[1-9][0-9]{0,27})$",
                      "type": "string"
                    },
                    "scale": {
                      "description": "Fractional scale; volume additionally requires <=6.",
                      "format": "uint8",
                      "maximum": 8,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "coefficient",
                    "scale"
                  ],
                  "type": "object"
                },
                "maxItems": 4,
                "minItems": 4,
                "type": "array"
              },
              "time": {
                "additionalProperties": false,
                "description": "Native label, explicit bucket, actual receipt and derivation provenance.",
                "properties": {
                  "bucket": {
                    "description": "Explicit half-open derived UTC bucket; never core-session/midnight defaults.",
                    "items": {
                      "additionalProperties": false,
                      "description": "Lossless UTC seconds/nanoseconds, independent from event/receipt semantics.",
                      "properties": {
                        "nanos": {
                          "description": "Nanosecond fraction, never rounded to milliseconds.",
                          "format": "uint32",
                          "maximum": 999999999,
                          "minimum": 0,
                          "type": "integer"
                        },
                        "seconds": {
                          "description": "Signed Unix seconds within Gregorian years 1..9999.",
                          "format": "int64",
                          "maximum": 253402300799,
                          "minimum": -62135596800,
                          "type": "integer"
                        }
                      },
                      "required": [
                        "nanos",
                        "seconds"
                      ],
                      "type": "object"
                    },
                    "maxItems": 2,
                    "minItems": 2,
                    "type": "array"
                  },
                  "calendar": {
                    "additionalProperties": false,
                    "description": "Required exact dated calendar witness, not proof by a calendar ID alone.",
