                      "date": {
                        "description": "Required effective date for calendar/action roles, null for the others.",
                        "maxLength": 10,
                        "minLength": 10,
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "kind": {
