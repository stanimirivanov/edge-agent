{
  "$id": "urn:edgeagent:schema:market-data:native-daily:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Untrusted quality-result DTO. Decoding is not proof of authority or producer execution.",
  "properties": {
    "capture": {
      "additionalProperties": false,
      "description": "Original native capture including exact response/selection identities and receipt times.",
      "properties": {
        "range": {
          "description": "Half-open requested native date range.",
          "items": {
            "description": "Canonical Gregorian YYYY-MM-DD in years 1 through 9999; not proof of a session.",
            "maxLength": 10,
            "minLength": 10,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "response_sha256": {
          "description": "Exact response body checksum; raw retention still requires separate rights.",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "rows": {
          "description": "Original captured rows, in strictly ascending native-date order.",
          "items": {
            "additionalProperties": false,
            "description": "One immutable captured row; the full retained bucket/calendar records remain required.",
            "properties": {
              "ohlc": {
                "description": "Exact unadjusted USD/share open/high/low/close.",
