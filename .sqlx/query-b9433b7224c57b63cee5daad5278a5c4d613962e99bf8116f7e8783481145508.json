  "query": "SELECT j.job_id,j.job,c.request FROM edgeagent_research_explanation_jobs j JOIN edgeagent_research_completions c USING(caller_scope,request_id) WHERE j.caller_scope=$1 AND ($2::text IS NULL OR j.job_id=$2) AND ($2::text IS NOT NULL OR NOT EXISTS(SELECT 1 FROM edgeagent_explanation_completions e WHERE e.job_id=j.job_id)) ORDER BY j.admitted_at,j.job_id LIMIT 1",
