{
  "db_name": "PostgreSQL",
  "query": "SELECT v.strategy,v.gross_cents,v.loss_cents,v.valued_seconds,v.valued_nanos,v.artifact,COALESCE(r.cash,0)::BIGINT AS \"cash!\",COALESCE(r.orders,0)::BIGINT AS \"orders!\" FROM simulation_valuation v LEFT JOIN (SELECT strategy,SUM(cash_cents)::BIGINT AS cash,COUNT(*)::BIGINT AS orders FROM simulation_reservation WHERE account=$1 GROUP BY strategy) r USING(strategy) WHERE v.account=$1 ORDER BY v.strategy LIMIT 33",
